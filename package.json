{
    "name": "@browsercore/proxy",
    "version": "0.1.0",
    "description": "Runtime-agnostic SOCKS5 and HTTP CONNECT proxy tunnels for the @browsercore stack. All I/O injected — handshakes run over any duplex Transport.",
    "repository": {
        "type": "git",
        "url": "https://github.com/jverneuer/browsercore-proxy.git"
    },
    "homepage": "https://github.com/jverneuer/browsercore-proxy#readme",
    "bugs": {
        "url": "https://github.com/jverneuer/browsercore-proxy/issues"
    },
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "bin",
        "LICENSE",
        "README.md"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsc -p tsconfig.json",
        "prepublishOnly": "npm run clean && npm run build",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "lint": "oxlint --type-aware src/"
    },
    "dependencies": {
        "@browsercore/contracts": "^0.2.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@browsercore/dev": "0.2.0",
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^4.1.10",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "7.0.2007",
        "tsx": "^4.19.2",
        "typescript": "^7.0.0",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=26.0.0"
    }
}
